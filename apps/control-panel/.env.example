# Required for inference and embeddings.
# Token needs Workers AI + AI Gateway run permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: route through a named AI Gateway for caching, logging and spend limits.
CLOUDFLARE_AI_GATEWAY=

# Optional: R2 for uploads and generated files.
# Without these the app falls back to local disk under .data/files.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Public origin, used to build the MCP server URL and local file URLs.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
