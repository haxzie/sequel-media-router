# Required for inference and embeddings.
# Token permission: Account > Workers AI > Edit  (the dashboard's Workers AI
# template prefills this). It covers both @cf/ models and partner models —
# an "AI Gateway" permission alone returns 401 / error 10000.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: route through a named AI Gateway for caching, logging and spend limits.
CLOUDFLARE_AI_GATEWAY=

# Optional: R2 for uploads and generated files.
# These are S3-compatible keys from R2 > Manage R2 API Tokens — NOT the API
# token above. Without them the app falls back to local disk under .data/files.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Public origin, used to build the MCP server URL and local file URLs.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
