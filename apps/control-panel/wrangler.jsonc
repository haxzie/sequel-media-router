{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "composio-forge-control-panel",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
  // Add R2 and D1 bindings here when moving off the local file store:
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "forge-media" }],
  // "d1_databases": [{ "binding": "DB", "database_name": "forge", "database_id": "..." }]
}
