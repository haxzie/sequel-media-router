{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "composio-sequel-control-panel",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // The apex, attached as a Custom Domain: Cloudflare issues the certificate
  // and writes the DNS record itself, so there is no A record to keep in step
  // with the Worker. Everything the product quotes — the MCP server URL, the
  // OAuth callback, the canonical links — is built from this origin.
  "routes": [{ "pattern": "sequelmcp.com", "custom_domain": true }],

  // Public, in the sense that they are already visible in the HTML the Worker
  // serves. Credentials live in secrets; see DEPLOY.md for the list.
  "vars": {
    "NEXT_PUBLIC_BASE_URL": "https://sequelmcp.com",
    "BETTER_AUTH_URL": "https://sequelmcp.com",
    "R2_BUCKET": "sequel-media"
  },

  // Auth, wallet, tasks and chats. Locally this is a miniflare-backed SQLite
  // file under .wrangler/state; the id is the production database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sequel",
      "database_id": "f1e2aeeb-e949-4188-bcbf-c1c813d10d21",
      "migrations_dir": "migrations"
    }
  ]

  // Media goes to the sequel-media bucket over the S3 API rather than a
  // binding, because the same uploader runs outside Workers in the SDK and
  // in scripts. R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY are secrets.
}
